---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { storefrontQuery } from "../../lib/shopify";
import { GET_PRODUCTS_BY_COLLECTION } from "../../lib/queries/products";
import StoreGrid from "../../components/react/StoreGrid";
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const seo = {
  title: "Gold Religious Jewelry: St. Jude, Crosses & Rosaries",
  description:
    "Wear your faith with pride. St. Jude medals, Virgin pendants, and Rosaries in durable gold. The ideal protection gift. Blessing and quality guaranteed.",
};

let products = [];
try {
  const response = await storefrontQuery(GET_PRODUCTS_BY_COLLECTION, {
    variables: {
      handle: "religioso",
    },
  }, lang);
  products =
    response.data?.collection?.products?.edges?.map((edge: any) => edge.node) ||
    [];
} catch (error) {
  console.error("Error fetching Religiosa collection:", error);
}
---

<Layout title={seo.title} description={seo.description}>
  <div class="max-w-[1920px] mx-auto pt-32 lg:pt-40">
    <div class="px-6 mb-2">
      <Breadcrumbs
        items={[{ label: "Home", href: "/en" }, { label: "Religious" }]}
      />
    </div>

    <div class="px-6 pb-6 text-center">
      <h1 class="main-heading">
        Religious Collection: Medals & Crosses - 14k Gold
      </h1>
      <p
        class="text-sm text-gray-400 font-light max-w-xs mx-auto leading-relaxed"
      >
        Symbols of devotion crafted in the finest 14k gold.
      </p>
    </div>

    {
      products.length > 0 ? (
        <StoreGrid client:load initialProducts={products} lang={lang} />
      ) : (
        <div class="text-center py-20 px-4">
          <p class="text-xl text-gray-500">
            No products found in this collection.
          </p>
        </div>
      )
    }
  </div>
</Layout>
