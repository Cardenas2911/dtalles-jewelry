---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactForm from "../components/react/ContactForm";

const seo = {
    title: "Contact Us | DTalles Jewelry Miami",
    description:
        "VIP concierge service. Questions about a piece or a shipment? Our Miami experts are ready to attend to every detail.",
};

const schema = {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "DTalles Customer Service",
    description: "VIP customer service and contact page for DTalles Jewelry.",
    mainEntity: {
        "@type": "LocalBusiness",
        name: "DTalles Jewelry",
        address: {
            "@type": "PostalAddress",
            streetAddress: "3949 NW 7th St d",
            addressLocality: "Miami",
            addressRegion: "FL",
            postalCode: "33126",
            addressCountry: "US",
        },
        telephone: "+17867644952",
        openingHours: "Mo-Sa 10:00-18:00",
        image: "https://dtallesjewelry.com/logo-gold.png",
        priceRange: "$$$",
    },
};
const lang = "en";
---

<Layout title={seo.title} description={seo.description}>
    {/* JSON-LD API Injection */}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <div class="bg-[#050505] min-h-screen text-[#FAFAF5]">
        {/* BREADCRUMBS */}
        <div class="max-w-7xl mx-auto px-6 pt-28">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
        </div>

        {/* HERO SECTION */}
        <section class="pb-16 px-6 text-center animate-fade-in">
            <h1
                class="text-4xl md:text-[42px] font-serif font-bold text-[#d4af37] mb-4 tracking-wide"
            >
                Attention to Every Detail.
            </h1>
            <p
                class="text-gray-400 font-light text-base md:text-lg max-w-xl mx-auto leading-relaxed"
            >
                Questions about a piece or a shipment? Talk to us — we are real experts in Miami.
            </p>
        </section>

        {/* MAIN GRID */}
        <div class="max-w-7xl mx-auto px-6 pb-24">
            <div
                class="grid grid-cols-1 lg:grid-cols-[40%_60%] gap-12 lg:gap-24"
            >
                {/* LEFT COLUMN: Info, Map, FAQ */}
                <div class="space-y-12">
                    {/* NAP Data */}
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <span
                                class="material-symbols-outlined text-[#d4af37] mt-1"
                                >storefront</span
                            >
                            <div>
                                <h3
                                    class="text-[#FAFAF5] font-bold uppercase tracking-widest text-sm mb-1"
                                >
                                    Visit Us
                                </h3>
                                <p class="text-gray-400 font-light">
                                    3949 NW 7th St d<br />
                                    Miami, FL 33126
                                </p>
                                <a
                                    href="https://maps.app.goo.gl/miami-link"
                                    target="_blank"
                                    class="inline-block mt-2 text-[#d4af37] text-xs border-b border-[#d4af37]/50 hover:border-[#d4af37] transition-colors"
                                >
                                    View on Google Maps
                                </a>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <span
                                class="material-symbols-outlined text-[#d4af37] mt-1"
                                >call</span
                            >
                            <div>
                                <h3
                                    class="text-[#FAFAF5] font-bold uppercase tracking-widest text-sm mb-1"
                                >
                                    Call Us
                                </h3>
                                <p class="text-gray-400 font-light mb-1">
                                    Personalized service Mon – Sat.
                                </p>
                                <a
                                    href="tel:+17867644952"
                                    class="text-lg font-serif text-white hover:text-[#d4af37] transition-colors"
                                >
                                    +1 (786) 764-4952
                                </a>
                            </div>
                        </div>
                    </div>

                    {/* Dark Map Embed */}
                    <div
                        class="w-full h-[300px] rounded-sm overflow-hidden border border-[#d4af37]/20 grayscale invert opacity-80 hover:opacity-100 hover:grayscale-0 hover:invert-0 transition-all duration-500"
                    >
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3592.7431858402165!2d-80.26412642454558!3d25.779044877341086!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9b76eca9d78e1%3A0x78e24354af26bf4!2s3949%20NW%207th%20St%20d%2C%20Miami%2C%20FL%2033126%2C%20EE.%20UU.!5e0!3m2!1ses-419!2sco!4v1770646756641!5m2!1ses-419!2sco"
                            width="100%"
                            height="100%"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>

                    {/* FAQ Accordion */}
                    <div class="border-t border-[#333] pt-8 space-y-4">
                        <h3
                            class="text-[#d4af37] text-sm font-bold uppercase tracking-widest mb-6"
                        >
                            Quick Answers
                        </h3>

                        <details
                            class="group [&_summary::-webkit-details-marker]:hidden"
                        >
                            <summary
                                class="flex cursor-pointer items-center justify-between gap-1.5 py-3 text-white group-hover:text-[#d4af37] transition-colors border-b border-[#333]"
                            >
                                <h4 class="font-medium text-sm">
                                    Do you offer insured shipping?
                                </h4>
                                <span
                                    class="material-symbols-outlined text-gray-500 transition duration-300 group-open:-rotate-180"
                                    >expand_more</span
                                >
                            </summary>
                            <p
                                class="mt-4 leading-relaxed text-gray-400 text-sm font-light"
                            >
                                Absolutely. All our shipments include full insurance and require a signature upon delivery to ensure your jewelry reaches you safely.
                            </p>
                        </details>

                        <details
                            class="group [&_summary::-webkit-details-marker]:hidden"
                        >
                            <summary
                                class="flex cursor-pointer items-center justify-between gap-1.5 py-3 text-white group-hover:text-[#d4af37] transition-colors border-b border-[#333]"
                            >
                                <h4 class="font-medium text-sm">
                                    Is the gold certified?
                                </h4>
                                <span
                                    class="material-symbols-outlined text-gray-500 transition duration-300 group-open:-rotate-180"
                                    >expand_more</span
                                >
                            </summary>
                            <p
                                class="mt-4 leading-relaxed text-gray-400 text-sm font-light"
                            >
                                Yes. Every DTalles piece is verified Solid 14k Gold. We provide a certificate of authenticity specifying the karat weight and actual gram weight of your jewelry. Lifetime warranty on metal quality.
                            </p>
                        </details>

                        <details
                            class="group [&_summary::-webkit-details-marker]:hidden"
                        >
                            <summary
                                class="flex cursor-pointer items-center justify-between gap-1.5 py-3 text-white group-hover:text-[#d4af37] transition-colors border-b border-[#333]"
                            >
                                <h4 class="font-medium text-sm">
                                    Do you buy used gold?
                                </h4>
                                <span
                                    class="material-symbols-outlined text-gray-500 transition duration-300 group-open:-rotate-180"
                                    >expand_more</span
                                >
                            </summary>
                            <p
                                class="mt-4 leading-relaxed text-gray-400 text-sm font-light"
                            >
                                We offer a "Renew Your Jewelry Box" plan. We take your gold as part payment and give you a +20% bonus above market value when you use it as credit for a new DTalles piece.
                            </p>
                        </details>
                    </div>
                </div>

                {/* RIGHT COLUMN: Form */}
                <div
                    class="bg-[#0a0a0a] p-8 md:p-12 rounded-sm border border-[#d4af37]/10 shadow-2xl"
                >
                    <ContactForm client:load lang={lang} />
                </div>
            </div>
        </div>
    </div>
</Layout>
