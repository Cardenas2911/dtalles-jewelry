---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

const seo = {
    title: "We Buy Gold in Miami: Best Price Per Gram",
    description:
        "Turn your old jewelry into instant cash. Transparent and safe appraisal at our Miami store. We pay the maximum market price of the day.",
};
---

<Layout title={seo.title} description={seo.description}>
    {/* BREADCRUMBS */}
    <div class="max-w-7xl mx-auto px-6 pt-28">
        <Breadcrumbs items={[{ label: "Home", href: "/en" }, { label: "Services", href: "#" }, { label: "Sell Gold" }]} />
    </div>

    <!-- Hero Section -->
    <div
        class="relative w-full h-[600px] flex items-center justify-center overflow-hidden"
    >
        <div class="absolute inset-0 bg-black/60 z-10"></div>
        <div class="absolute inset-0 bg-[#0a0a0a] z-0">
            <div class="w-full h-full bg-gradient-to-br from-gray-900 to-black">
            </div>
        </div>

        <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
            <span
                class="inline-block py-1 px-3 border border-[#d4af37] text-[#d4af37] rounded-full text-xs uppercase tracking-[0.2em] mb-6"
                >Miami, FL</span
            >
            <h1
                class="text-5xl md:text-7xl font-serif text-[#FAFAF5] mb-6 leading-tight"
            >
                Turn Your Gold Into <br />
                <span class="text-[#d4af37] italic">Instant Cash</span>
            </h1>
            <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto font-light">
                No tricks, no waiting. We use certified scales in plain sight and
                pay the <strong>maximum market price of the day</strong>, guaranteed.
            </p>
            <div class="flex flex-col md:flex-row gap-4 justify-center">
                <a
                    href="#appraise"
                    class="bg-[#d4af37] text-black px-8 py-4 rounded-full font-bold text-lg hover:bg-white transition-all shadow-[0_0_20px_rgba(212,175,55,0.3)]"
                >
                    Get an Offer Today
                </a>
                <a
                    href="tel:+17867644952"
                    class="border border-white/30 text-white px-8 py-4 rounded-full font-medium hover:bg-white/10 transition-all flex items-center justify-center gap-2"
                >
                    <span class="material-symbols-outlined">call</span>
                    Call Now
                </a>
            </div>
        </div>
    </div>

    <!-- Trust Signals / Process -->
    <div class="py-20 bg-[#050505] px-4">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-serif text-[#FAFAF5] mb-4">
                    Your Gold, Your Trust, Your Payment
                </h2>
                <div class="h-0.5 w-24 bg-[#d4af37] mx-auto"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div
                    class="p-8 border border-white/5 rounded-2xl bg-[#0a0a0a] hover:border-[#d4af37]/30 transition-all group"
                >
                    <div
                        class="w-16 h-16 bg-[#d4af37]/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-[#d4af37] transition-all"
                    >
                        <span
                            class="material-symbols-outlined text-3xl text-[#d4af37] group-hover:text-black"
                            >scale</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#FAFAF5] mb-3">
                        1. Transparent Appraisal
                    </h3>
                    <p class="text-gray-400">
                        We weigh and test your pieces <strong>in front of you</strong>. We show you the live gold price. Nothing hidden.
                    </p>
                </div>

                <div
                    class="p-8 border border-white/5 rounded-2xl bg-[#0a0a0a] hover:border-[#d4af37]/30 transition-all group"
                >
                    <div
                        class="w-16 h-16 bg-[#d4af37]/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-[#d4af37] transition-all"
                    >
                        <span
                            class="material-symbols-outlined text-3xl text-[#d4af37] group-hover:text-black"
                            >verified</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#FAFAF5] mb-3">
                        2. Best Offer Guaranteed
                    </h3>
                    <p class="text-gray-400">
                        Got broken, mismatched, or damaged jewelry? We buy it all! Gold 10k, 14k, 18k, and 24k.
                    </p>
                </div>

                <div
                    class="p-8 border border-white/5 rounded-2xl bg-[#0a0a0a] hover:border-[#d4af37]/30 transition-all group"
                >
                    <div
                        class="w-16 h-16 bg-[#d4af37]/10 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-[#d4af37] transition-all"
                    >
                        <span
                            class="material-symbols-outlined text-3xl text-[#d4af37] group-hover:text-black"
                            >payments</span
                        >
                    </div>
                    <h3 class="text-xl font-bold text-[#FAFAF5] mb-3">
                        3. Immediate Payment
                    </h3>
                    <p class="text-gray-400">
                        If you like our offer, we pay you instantly in cash or via Zelle/Wire transfer.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- What We Buy Grid -->
    <div class="py-20 bg-[#0a0a0a] border-y border-white/5">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div>
                    <span
                        class="text-[#d4af37] uppercase tracking-widest text-sm font-bold mb-2 block"
                        >We Accept All Types of Gold</span
                    >
                    <h2 class="text-4xl font-serif text-[#FAFAF5] mb-6">
                        What can you sell today?
                    </h2>
                    <p class="text-gray-400 mb-8 text-lg">
                        Many customers don't realize their broken or antique jewelry has great value. At DTalles Jewelry we turn them into liquidity for you.
                    </p>

                    <ul class="space-y-4">
                        <li class="flex items-center gap-4 text-gray-300">
                            <span
                                class="material-symbols-outlined text-[#d4af37]"
                                >check_circle</span
                            >
                            <span>Chains and Bracelets (even broken ones)</span>
                        </li>
                        <li class="flex items-center gap-4 text-gray-300">
                            <span
                                class="material-symbols-outlined text-[#d4af37]"
                                >check_circle</span
                            >
                            <span>Graduation and Engagement Rings</span>
                        </li>
                        <li class="flex items-center gap-4 text-gray-300">
                            <span
                                class="material-symbols-outlined text-[#d4af37]"
                                >check_circle</span
                            >
                            <span>Gold Coins and Bullion</span>
                        </li>
                        <li class="flex items-center gap-4 text-gray-300">
                            <span
                                class="material-symbols-outlined text-[#d4af37]"
                                >check_circle</span
                            >
                            <span>Luxury Watches (Rolex, Cartier, Patek)</span>
                        </li>
                    </ul>
                </div>
                <div
                    class="relative h-[500px] bg-[#121212] rounded-lg overflow-hidden border border-white/5"
                >
                    <div
                        class="absolute inset-0 flex items-center justify-center text-white/20"
                    >
                        <span class="material-symbols-outlined text-9xl"
                            >diamond</span
                        >
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trade-In Offer (The Hook) -->
    <div class="relative py-24 px-4 overflow-hidden">
        <div class="absolute inset-0 bg-[#d4af37] z-0"></div>
        <div
            class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 z-10"
        >
        </div>

        <div class="relative z-20 max-w-4xl mx-auto text-center">
            <h2 class="text-black font-serif text-3xl md:text-5xl mb-6">
                "Refresh Your Jewelry Box" Plan
            </h2>
            <p class="text-black/80 text-xl font-medium mb-8 max-w-2xl mx-auto">
                Don't want cash? We give you a <strong>20% BONUS</strong> on top of your gold's value if you use it as store credit toward a new DTalles piece.
            </p>
            <a
                href="/en/women"
                class="inline-block bg-black text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-gray-900 transition-all shadow-xl"
            >
                Browse New Collection
            </a>
            <p class="text-black/60 text-xs mt-6">
                *Subject to in-store verification. Terms and conditions apply.
            </p>
        </div>
    </div>

    <!-- Map / Location -->
    <div class="py-20 bg-[#050505] px-4" id="appraise">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-serif text-[#FAFAF5] mb-8">
                Visit Us in Miami
            </h2>

            <!-- Google Maps Embed -->
            <div
                class="w-full h-[400px] bg-gray-800 rounded-xl mb-12 overflow-hidden shadow-2xl border border-white/10"
            >
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3592.7431858402165!2d-80.26412642454558!3d25.779044877341086!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9b76eca9d78e1%3A0x78e24354af26bf4!2s3949%20NW%207th%20St%20d%2C%20Miami%2C%20FL%2033126%2C%20EE.%20UU.!5e0!3m2!1ses-419!2sco!4v1770646756641!5m2!1ses-419!2sco"
                    width="100%"
                    height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
                <div>
                    <h3 class="text-[#d4af37] font-bold mb-2 uppercase text-sm">
                        Address
                    </h3>
                    <p class="text-gray-300">
                        3949 NW 7th St d<br />
                        Miami, FL 33126
                    </p>
                </div>
                <div>
                    <h3 class="text-[#d4af37] font-bold mb-2 uppercase text-sm">
                        Buying Hours
                    </h3>
                    <p class="text-gray-300">
                        Mon – Sat: 10am – 7pm<br />
                        Sunday: By Appointment
                    </p>
                </div>
                <div>
                    <h3 class="text-[#d4af37] font-bold mb-2 uppercase text-sm">
                        Contact
                    </h3>
                    <p class="text-gray-300">
                        <a
                            href="tel:+17867644952"
                            class="hover:text-white transition-colors"
                            >+1 (786) 764‑4952</a
                        ><br />
                        <a
                            href="tel:+17867644952"
                            class="hover:text-white transition-colors"
                            >+1 (786) 764‑4952</a
                        >
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>
