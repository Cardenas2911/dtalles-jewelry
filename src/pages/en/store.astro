---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StoreGrid from "../../components/react/StoreGrid";
import { storefrontQuery } from "../../lib/shopify";
import { ALL_PRODUCTS_QUERY } from "../../lib/queries/allProducts";
import { getLangFromUrl, getTranslationFunctionForLang } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = getTranslationFunctionForLang(lang);

let products = [];
try {
    const response = await storefrontQuery(ALL_PRODUCTS_QUERY, {
        variables: { first: 20 },
    }, lang);
    if (response.errors) {
        console.error("Shopify API Errors:", response.errors);
    }
    products =
        response.data?.products?.edges?.map((edge: any) => edge.node) || [];
} catch (error) {
    console.error("Error fetching products:", error);
}
---

<Layout
    title="Store - DTalles Jewelry"
    description="Explore our collection of exquisite gold jewelry."
>
    <div class="bg-[#050505] min-h-screen">
        <!-- BREADCRUMBS -->
        <div class="max-w-7xl mx-auto px-6 pt-28">
            <Breadcrumbs items={[{ label: "Home", href: "/en" }, { label: "Store" }]} />
        </div>

        <!-- Hero Section -->
        <div
            class="relative w-full h-[30vh] min-h-[300px] flex flex-col items-center justify-center overflow-hidden"
        >
            <div
                class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-yellow-900/20 via-[#050505] to-[#000000] z-0"
            >
            </div>

            <!-- Content -->
            <div
                class="relative z-10 text-center px-4 max-w-4xl mx-auto animate-fade-in"
            >
                <h1
                    class="text-4xl md:text-6xl font-serif text-[#FAFAF5] mb-3 tracking-wide"
                >
                    Exclusive Collection
                </h1>
                <p
                    class="text-[#d4af37] font-serif italic text-2xl md:text-3xl mb-6"
                >
                    The Art of Detail
                </p>
                <p
                    class="text-gray-400 text-sm md:text-base font-sans max-w-lg mx-auto mb-8 tracking-wide px-4"
                >
                    14k Gold Jewelry & Diamonds in Miami. <br
                        class="hidden md:block"
                    /> Solid pieces with lifetime guarantee.
                </p>
            </div>
        </div>

        <!-- Store Grid (React Component) -->
        <div class="max-w-[1920px] mx-auto pb-12 mt-12">
            <StoreGrid client:load initialProducts={products} lang={lang} />
        </div>

        <!-- Trust Section (Footer of Category) -->
        <div class="border-t border-white/5 bg-[#0a0a0a] py-16 px-6">
            <div
                class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 text-center"
            >
                <!-- Trust Item 1 -->
                <div class="flex flex-col items-center group">
                    <div
                        class="w-12 h-12 rounded-full bg-[#d4af37]/10 flex items-center justify-center mb-4 group-hover:bg-[#d4af37] transition-all duration-500"
                    >
                        <span
                            class="material-symbols-outlined text-[#d4af37] group-hover:text-black"
                            >verified_user</span
                        >
                    </div>
                    <h3 class="text-[#FAFAF5] font-serif text-lg mb-2">
                        Guaranteed Authenticity
                    </h3>
                    <p class="text-gray-500 text-sm max-w-xs leading-relaxed">
                        Every piece includes a carat certificate and verified real weight.
                    </p>
                </div>

                <!-- Trust Item 2 -->
                <div class="flex flex-col items-center group">
                    <div
                        class="w-12 h-12 rounded-full bg-[#d4af37]/10 flex items-center justify-center mb-4 group-hover:bg-[#d4af37] transition-all duration-500"
                    >
                        <span
                            class="material-symbols-outlined text-[#d4af37] group-hover:text-black"
                            >local_shipping</span
                        >
                    </div>
                    <h3 class="text-[#FAFAF5] font-serif text-lg mb-2">
                        Insured Shipping
                    </h3>
                    <p class="text-gray-500 text-sm max-w-xs leading-relaxed">
                        Your jewelry travels protected to your door. 24/7 tracking included.
                    </p>
                </div>

                <!-- Trust Item 3 -->
                <div class="flex flex-col items-center group">
                    <div
                        class="w-12 h-12 rounded-full bg-[#d4af37]/10 flex items-center justify-center mb-4 group-hover:bg-[#d4af37] transition-all duration-500"
                    >
                        <span
                            class="material-symbols-outlined text-[#d4af37] group-hover:text-black"
                            >diamond</span
                        >
                    </div>
                    <h3 class="text-[#FAFAF5] font-serif text-lg mb-2">
                        The DTalles Experience
                    </h3>
                    <p class="text-gray-500 text-sm max-w-xs leading-relaxed">
                        Luxury packaging ready for gifting included in every order.
                    </p>
                </div>
            </div>
        </div>
    </div>
</Layout>
