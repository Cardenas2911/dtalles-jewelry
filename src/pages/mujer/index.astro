---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Layout from "../../layouts/Layout.astro";
import { storefrontQuery } from "../../lib/shopify";
import { GET_PRODUCTS_BY_COLLECTION } from "../../lib/queries/products";
import ProductCard from "../../components/react/ProductCard";
import StoreGrid from "../../components/react/StoreGrid";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRoute } from "../../utils/paths";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEnglish = lang === 'en';

const seo = {
    title: isEnglish ? "Women's Gold Jewelry | Necklaces, Earrings & Gifts" : "Joyas de Oro para Mujer | Collares, Aretes y Regalos",
    description: isEnglish 
        ? "Find the perfect detail for her. From minimalist necklaces to complete gift sets. Hypoallergenic 14k gold and luxury packaging included."
        : "Encuentra el detalle perfecto para ella. Desde gargantillas minimalistas hasta sets de regalo completos. Oro 14k hipoalergénico y empaque de lujo incluido.",
};

let products = [];
try {
    const response = await storefrontQuery(GET_PRODUCTS_BY_COLLECTION, {
        variables: {
            handle: "mujer",
        },
    }, lang);
    products =
        response.data?.collection?.products?.edges?.map(
            (edge: any) => edge.node,
        ) || [];
} catch (error) {
    console.error("Error fetching Mujer collection:", error);
}
---

<Layout title={seo.title} description={seo.description}>
    <div class="max-w-[1920px] mx-auto pt-32 lg:pt-40">
        <div class="px-6 mb-2">
            <Breadcrumbs
                items={[
                    { label: t('ui.nav.home'), href: getRoute("/", lang) }, 
                    { label: t('nav.women') }
                ]}
            />
        </div>

        <div class="px-6 pb-6 text-center">
            <h1 class="main-heading">
                {isEnglish ? "Women's Collection: 14k Gold Jewelry - Timeless Elegance" : "Colección Mujer: Joyas de Oro 14k - Elegancia Eterna"}
            </h1>
            <p
                class="text-sm text-gray-400 font-light max-w-xs mx-auto leading-relaxed"
            >
                {isEnglish ? "Fine and elegant designs to highlight her natural beauty. Guaranteed 14k Gold." : "Diseños finos y elegantes para resaltar su belleza natural. Oro 14k garantizado."}
            </p>
        </div>

        {
            products.length > 0 ? (
                <StoreGrid client:load initialProducts={products} lang={lang} />
            ) : (
                <div class="text-center py-20 px-4">
                    <p class="text-xl text-gray-500">
                        {isEnglish ? "No products found in this collection." : "No se encontraron productos en esta colección."}
                    </p>
                </div>
            )
        }
    </div>
</Layout>
