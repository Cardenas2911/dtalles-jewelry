---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Layout from "../../../layouts/Layout.astro";
import { storefrontQuery } from "../../../lib/shopify";
import { GET_PRODUCTS_BY_COLLECTION } from "../../../lib/queries/products";
import ProductCard from "../../../components/react/ProductCard";
import StoreGrid from "../../../components/react/StoreGrid";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import { getRoute } from "../../../utils/paths";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEnglish = lang === 'en';

const seo = {
  title: isEnglish ? "Children's Jewelry: Gold Earrings for Babies & Girls" : "Joyería Infantil: Aretes de Oro para Bebés y Niñas",
  description: isEnglish
    ? "Take care of their ears with hypoallergenic 14k gold earrings. Security clasps (screw type) that don't hurt. The first detail for a lifetime."
    : "Cuida sus oídos con aretes de oro 14k hipoalergénicos. Broches de seguridad (tipo rosca) que no lastiman. El primer detalle para toda la vida.",
};

let products = [];
try {
  // Intentamos con 'infantil' o 'ninos', el handle debe existir en Shopify
  const response = await storefrontQuery(GET_PRODUCTS_BY_COLLECTION, {
    variables: {
      handle: "ninos",
    },
  }, lang);
  products =
    response.data?.collection?.products?.edges?.map((edge: any) => edge.node) ||
    [];
} catch (error) {
  console.error("Error fetching Ninos collection:", error);
}
---

<Layout title={seo.title} description={seo.description}>
  <div class="max-w-[1920px] mx-auto pt-32 lg:pt-40">
    <div class="px-6 mb-2">
            <Breadcrumbs
                items={[
                    { label: t('ui.nav.home'), href: getRoute("/", lang) }, 
                    { label: t('nav.kids') }
                ]}
            />
    </div>

    <div class="px-6 pb-6 text-center">
      <h1 class="main-heading">
        {isEnglish ? "Kids' Collection: 14k Gold Earrings - Hypoallergenic" : "Colección Infantil: Aretes de Oro 14k - Hipoalergénicos"}
      </h1>
      <p
        class="text-sm text-gray-400 font-light max-w-xs mx-auto leading-relaxed mb-4"
      >
        {isEnglish ? "Hypoallergenic 14k gold jewelry for babies and girls. The first detail for a lifetime." : "Joyas de oro 14k hipoalergénicas para bebés y niñas. El primer detalle para toda la vida."}
      </p>
      <div
        class="inline-block bg-[#d4af37]/10 text-[#d4af37] px-4 py-2 rounded-full text-xs"
      >
        <span class="font-bold">{isEnglish ? "Safety First:" : "Seguridad Primero:"}</span> {isEnglish ? "Screw clasp" : "Broche de rosca"}
      </div>
    </div>

    {
      products.length > 0 ? (
        <StoreGrid client:load initialProducts={products} lang={lang} />
      ) : (
        <div class="text-center py-20 px-4">
          <p class="text-xl text-gray-500">
            {isEnglish ? "No products found in this collection." : "No se encontraron productos en esta colección."}
          </p>
        </div>
      )
    }
  </div>
</Layout>
