---
import SEO from "../../components/SEO.astro";
import "../../styles/global.css";
import { resolvePath } from "../../utils/paths";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    title: t('links.shop'),
    url: resolvePath("/tienda"),
    icon: "storefront",
    gradient: "from-[#d4af37] to-[#b38f2d]",
    text: "text-[#050505]",
    shadow: "shadow-[0_4px_15px_rgba(212,175,55,0.3)]"
  },
  {
    title: t('links.whatsapp'),
    url: "https://wa.me/17867644952?text=" + encodeURIComponent(lang === 'es' ? '¡Hola! Deseo más información.' : 'Hi! I would like more information.'),
    icon: "chat",
    gradient: "from-[#25D366] to-[#128C7E]",
    text: "text-white",
    shadow: "shadow-[0_4px_15px_rgba(37,211,102,0.3)]"
  },
  {
    title: t('links.renew'),
    url: "https://wa.me/17867644952?text=" + encodeURIComponent(lang === 'es' ? '¡Hola! Me interesa el Plan Renueva.' : 'Hi! I am interested in the Renew Plan.'),
    icon: "autorenew",
    gradient: "from-[#1a1a1a] to-[#222222]",
    text: "text-[#d4af37]",
    border: "border border-[#d4af37]/50",
    shadow: "shadow-none"
  },
  {
    title: t('links.showroom'),
    url: "https://wa.me/17867644952?text=" + encodeURIComponent(lang === 'es' ? '¡Hola! Me gustaría agendar una cita en el showroom.' : 'Hi! I would like to schedule an appointment at the showroom.'),
    icon: "calendar_month",
    gradient: "from-[#1a1a1a] to-[#222222]",
    text: "text-white",
    border: "border border-white/20",
    shadow: "shadow-none"
  }
];

const alternateLang = lang === 'es' ? 'en' : 'es';
const alternatePath = lang === 'es' ? '/en/links' : '/enlaces';
---

<!doctype html>
<html lang={lang} class="dark">
    <head>
        <SEO title={t('links.title')} description={t('links.description')} />
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Montserrat:wght@200..800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
            rel="stylesheet"
        />
        <style>
            .material-symbols-outlined {
                font-variation-settings:
                    "FILL" 0,
                    "wght" 300,
                    "GRAD" 0,
                    "opsz" 24;
            }
            body {
                background-color: var(--color-bg-dark);
                color: var(--color-text-light);
                font-family: "Manrope", system-ui, sans-serif;
            }
            h1, h2, h3 {
                font-family: "Playfair Display", serif;
            }
        </style>
    </head>
    <body class="min-h-screen bg-[#050505] text-white selection:bg-[#d4af37] selection:text-black flex flex-col items-center p-6 relative overflow-x-hidden">
        
        {/* Background Effects */}
        <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-[#d4af37]/[0.07] blur-[100px] rounded-full mix-blend-screen"></div>
            <div class="absolute bottom-0 left-0 w-full h-[300px] bg-gradient-to-t from-black to-transparent"></div>
        </div>

        <main class="w-full max-w-[400px] relative z-10 flex flex-col items-center pt-8 pb-12 min-h-full flex-grow">
            {/* Logo / Header */}
            <div class="flex flex-col items-center mb-10 w-full animate-fade-in-up">
                <div class="w-28 h-28 rounded-full border border-[#d4af37]/30 bg-black/50 backdrop-blur-md flex items-center justify-center overflow-hidden mb-5 shadow-[0_0_40px_rgba(212,175,55,0.1)] relative group p-4">
                    <img src={resolvePath("/images/Logo.webp")} alt="DTalles Jewelry" class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-110" onerror="this.src='/images/Logo.png'" />
                </div>
                <h1 class="text-3xl font-bold tracking-widest text-center uppercase text-[#d4af37] mb-1">DTalles</h1>
                <h2 class="text-gray-400 text-xs mt-0 uppercase tracking-[0.3em] font-light">Fine Jewelry</h2>
                <div class="flex items-center gap-1 mt-4 text-[#d4af37]/80 bg-[#d4af37]/10 px-3 py-1 rounded-full border border-[#d4af37]/20">
                    <span class="material-symbols-outlined text-[14px]">location_on</span>
                    <span class="text-[10px] uppercase tracking-wider font-bold">{t('links.miami')}</span>
                </div>

                {/* Idioma Switcher */}
                <a 
                    href={alternatePath}
                    class="mt-6 flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 text-[10px] uppercase tracking-widest font-bold text-gray-400 hover:text-[#d4af37] hover:border-[#d4af37]/30 transition-all active:scale-95"
                >
                    <span class="material-symbols-outlined text-[16px]">language</span>
                    {lang === 'es' ? 'English Version' : 'Versión en Español'}
                </a>
            </div>

            {/* Links Container */}
            <div class="w-full flex flex-col gap-4">
                {links.map((link, index) => (
                    <a 
                        href={link.url}
                        target={link.url.startsWith('https') ? "_blank" : "_self"}
                        rel={link.url.startsWith('https') ? "noopener noreferrer" : ""}
                        class={`group relative w-full flex items-center justify-between px-6 py-4 rounded-2xl bg-gradient-to-r ${link.gradient} ${link.text} ${link.border || ''} ${link.shadow} transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] overflow-hidden`}
                        style={`animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) ${index * 0.1 + 0.2}s both;`}
                    >
                        <div class="absolute inset-0 bg-white/0 group-hover:bg-white/10 transition-colors duration-300"></div>
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[200%] group-hover:animate-shimmer"></div>
                        
                        <span class="font-bold tracking-wider text-sm uppercase relative z-10">{link.title}</span>
                        <div class="relative z-10 w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white/20 transition-colors">
                            <span class="material-symbols-outlined text-lg">{link.icon}</span>
                        </div>
                    </a>
                ))}
            </div>

            {/* Redes Sociales Secundarias (Opcional, pero bueno para Linktree) */}
            <div class="mt-10 flex gap-4 animate-fade-in-up" style="animation-delay: 0.7s;">
                <a href="https://instagram.com/dtalles_jewelry" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full border border-white/10 bg-white/5 flex items-center justify-center text-white/70 hover:text-[#d4af37] hover:border-[#d4af37]/50 transition-all hover:scale-110">
                    {/* SVG simple de IG */}
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href="https://tiktok.com/@dtalles_jewelry" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full border border-white/10 bg-white/5 flex items-center justify-center text-white/70 hover:text-[#d4af37] hover:border-[#d4af37]/50 transition-all hover:scale-110">
                    {/* SVG simple de TikTok */}
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12.525.02c1.31-.02 2.61-.014 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                </a>
            </div>
            
            <div class="mt-8 text-center animate-fade-in-up" style="animation-delay: 0.9s;">
                <p class="text-[10px] text-gray-500 uppercase tracking-widest font-bold">© {new Date().getFullYear()} DTalles Jewelry</p>
            </div>
        </main>
        
        <style>
            @keyframes fade-in-up {
                from { opacity: 0; transform: translateY(30px) scale(0.95); }
                to { opacity: 1; transform: translateY(0) scale(1); }
            }
            .animate-fade-in-up {
                animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }
            @keyframes shimmer {
                100% { transform: translateX(100%); }
            }
            .animate-shimmer {
                animation: shimmer 2s infinite;
            }
        </style>
    </body>
</html>
