---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const seo = {
  title: "Shipping & Delivery | DTalles Jewelry",
  description: "Information about our shipping times, costs, and insured delivery methods.",
};
---

<Layout title={seo.title} description={seo.description}>
  <div class="max-w-[1920px] mx-auto pt-32 lg:pt-40 pb-20 px-6 min-h-[80vh]">
    <Breadcrumbs items={[{ label: "Home", href: "/en" }, { label: "Shipping" }]} />

    <div class="max-w-4xl mx-auto mt-12 animate-fade-in text-center">
        <span class="material-symbols-outlined text-6xl text-[#d4af37] mb-6">local_shipping</span>
        <h1 class="font-serif text-4xl md:text-5xl text-[#FAFAF5] mb-6">Shipping & Delivery</h1>
        <p class="text-gray-400 font-light max-w-2xl mx-auto mb-16">
            We ensure your jewelry arrives safely and on time. All our shipments are insured and require a signature upon delivery for your peace of mind.
        </p>
    </div>

    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Standard Shipping */}
        <div class="bg-[#111] border border-white/5 p-8 hover:border-[#d4af37]/30 transition-colors">
            <div class="text-[#d4af37] text-xs font-bold uppercase tracking-widest mb-2">Standard Option</div>
            <h3 class="text-2xl font-serif text-white mb-4">Free Shipping</h3>
            <p class="text-gray-400 font-light text-sm mb-6">Available for orders over $200. Secure delivery via USPS Priority Mail or UPS Ground.</p>
            <ul class="text-gray-500 text-sm space-y-2">
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> 3-5 Business Days</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> Tracking Number</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> Insurance Included</li>
            </ul>
        </div>

         {/* Express Shipping */}
         <div class="bg-[#111] border border-white/5 p-8 hover:border-[#d4af37]/30 transition-colors">
            <div class="text-[#d4af37] text-xs font-bold uppercase tracking-widest mb-2">Fast Option</div>
            <h3 class="text-2xl font-serif text-white mb-4">Express Shipping</h3>
            <p class="text-gray-400 font-light text-sm mb-6">For when you need your jewelry as soon as possible. Flat rate of $25.00.</p>
            <ul class="text-gray-500 text-sm space-y-2">
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> 1-2 Business Days</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> Processing Priority</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-xs">check_circle</span> Signature Required</li>
            </ul>
        </div>
    </div>

    <div class="max-w-4xl mx-auto mt-16 prose prose-invert prose-lg text-gray-300 font-light">
        <h3 class="font-serif text-[#d4af37]">Important Notes</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm">
            <li>Processing time is 24 to 48 hours before the order is dispatched.</li>
            <li>We do not ship to PO Boxes for security reasons.</li>
            <li>During peak seasons (Christmas, Valentine's Day), delivery times may vary slightly.</li>
            <li>If your package gets lost or arrives damaged, contact us immediately within 48 hours after delivery.</li>
        </ul>
    </div>

  </div>
</Layout>
