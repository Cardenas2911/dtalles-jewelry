---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const seo = {
  title: "Lifetime Warranty | DTalles Jewelry",
  description: "Our quality promise. Lifetime warranty on the authenticity of our Solid 14k Gold jewelry.",
};
---

<Layout title={seo.title} description={seo.description}>
  <div class="max-w-[1920px] mx-auto pt-32 lg:pt-40 pb-20 px-6 min-h-[80vh]">
    <Breadcrumbs items={[{ label: "Home", href: "/en" }, { label: "Warranty" }]} />

    <div class="max-w-4xl mx-auto mt-12 animate-fade-in">
        <div class="text-center mb-16 bg-[#111] p-12 border border-[#d4af37]/30 relative overflow-hidden">
             {/* Decorative background element */}
             <div class="absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-[#d4af37] rounded-full mix-blend-overlay opacity-10 filter blur-3xl"></div>
             
             <span class="material-symbols-outlined text-6xl text-[#d4af37] mb-6">verified_user</span>
             <h1 class="font-serif text-4xl md:text-5xl text-[#FAFAF5] mb-6">Lifetime Warranty</h1>
             <p class="text-gray-300 text-lg font-light max-w-xl mx-auto">
                When you shop at DTalles, you are investing in real quality. We stand behind every gram we sell.
             </p>
        </div>

        <section class="space-y-16">
            <div class="flex flex-col md:flex-row gap-8 items-start">
                <div class="flex-1">
                    <h2 class="text-2xl font-serif text-[#d4af37] mb-4">Metal Authenticity</h2>
                    <p class="text-gray-400 font-light leading-relaxed mb-4">
                        We guarantee for life that your piece is <strong>Solid 14k Gold</strong>. If at any time, through professional testing, the metal is found not to meet karat standards (14k/585), we will replace the piece or refund 100% of your money.
                    </p>
                    <p class="text-xs text-gray-500 uppercase tracking-widest">Never fades • Never tarnishes</p>
                </div>
                <div class="flex-1 border-l border-white/10 pl-8">
                     <h2 class="text-2xl font-serif text-white mb-4">Manufacturing Defects</h2>
                    <p class="text-gray-400 font-light leading-relaxed">
                        We cover any structural or assembly defects during the first <strong>30 days</strong>. Defective clasps, poorly soldered links, or loose stones (in factory settings) will be repaired free of charge.
                    </p>
                </div>
            </div>

            <div class="bg-red-900/10 border border-red-500/20 p-8 rounded-sm">
                <h3 class="text-xl font-serif text-red-200 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined">warning</span> Exclusions
                </h3>
                <p class="text-gray-400 font-light text-sm mb-4">
                    Our warranty does not cover damage caused by normal daily wear, accidents, or negligence. This includes:
                </p>
                <ul class="list-disc pl-5 space-y-1 text-sm text-gray-500">
                    <li>Chains stretched or broken from pulling.</li>
                    <li>Dents or scratches from impact.</li>
                    <li>Lost stones from knocks (after 30 days).</li>
                    <li>Pieces repaired by unauthorized third parties.</li>
                </ul>
            </div>
            
             <div class="text-center">
                <p class="text-gray-300 mb-6">Need to submit a warranty claim?</p>
                <a href="/en/contact" class="text-[#d4af37] underline underline-offset-4 hover:text-white transition-colors">Contact us here</a>
            </div>
        </section>
    </div>
  </div>
</Layout>
