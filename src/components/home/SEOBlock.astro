---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="max-w-3xl mx-auto px-6 py-24 text-center">
    <span
        class="block w-px h-16 bg-gradient-to-b from-transparent via-[#d4af37] to-transparent mx-auto mb-8"
    ></span>

    <h2
        class="text-2xl md:text-3xl font-serif text-[#FAFAF5] mb-6 tracking-wide"
    >
        {t('home.seo.title')}
    </h2>

    <p
        class="text-[#FCEebb] text-base md:text-lg font-light leading-loose opacity-90"
    >
        {t('home.seo.text')}
    </p>

    <div class="mt-8 flex justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#d4af37]/40"></span>
        <span class="w-2 h-2 rounded-full bg-[#d4af37]/40"></span>
        <span class="w-2 h-2 rounded-full bg-[#d4af37]/40"></span>
    </div>
</section>
